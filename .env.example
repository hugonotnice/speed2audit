# ==============================================================================
# Speed2Audit Environment Configuration Example
# Copy this file to .env and configure your values.
# ==============================================================================

# Core App Settings
SPEED2AUDIT_ENV=development
SPEED2AUDIT_LOG_LEVEL=INFO
DATABASE_PATH=speed2audit.db

# LLM Engine (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# WhatsApp Gateway (WAHA - WhatsApp HTTP API in Docker)
WAHA_BASE_URL=http://localhost:3000
WAHA_SESSION=default
WAHA_API_KEY=

# Observability & Tracing (Arize Phoenix - Local)
PHOENIX_ENABLE=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# Chainlit Cockpit Settings
CHAINLIT_PORT=8000
CHAINLIT_HOST=0.0.0.0

# LangSmith / LangGraph Studio Tracing (Optional)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=speed2audit
