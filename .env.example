# ==============================================================================
# Speed2Audit Environment Configuration Example
# Copy this file to .env and configure your values.
# ==============================================================================

# Core App Settings
SPEED2AUDIT_ENV=development
SPEED2AUDIT_LOG_LEVEL=INFO

# LLM Evaluation Engine (Pick your default provider & keys)
SPEED2AUDIT_LLM_PROVIDER=gemini  # Options: gemini, openai, anthropic, ollama
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Channels Configuration (To be configured as channels are integrated)
# WhatsApp (e.g. Meta Cloud API or Evolution API / Z-API / Baileys)
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=

# Email (SMTP / IMAP / SendGrid)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Database / Storage (When configured)
# DATABASE_URL=sqlite:///./speed2audit.db
